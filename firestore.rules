rules_version = '2';
// Single-user MVP. Tighten when Firebase Auth is wired up:
//   - allow read/write per-doc only if request.auth.uid == resource.data.user_id
//   - allow admin to read all (request.auth.token.email == 'cory.salisbury@gmail.com')
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // For now: server-only access via Admin SDK (which bypasses rules).
      // Block all client SDK access until Firebase Auth lands.
      allow read, write: if false;
    }
  }
}
